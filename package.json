{
	"name": "pi-commit-guard",
	"version": "0.1.0",
	"description": "pi extension: watches the working diff vs HEAD, coaches the model to split work into minimal reviewable batches, and reports over-limit results to the user at run end. Never blocks the agent.",
	"main": "src/index.ts",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"git",
		"commit",
		"guard",
		"minimal-commits",
		"coding-agent",
		"ai",
		"llm"
	],
	"license": "MIT",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.20.3",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check:biome": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"type": "commonjs"
}
